{
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "no-referrer" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
            ]
        },
        {
            "source": "/(logo.jpg|dashboard.mp4)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        }
    ],
    "rewrites": [
        { "source": "/anime/:id*", "destination": "/index.html" },
        { "source": "/search/:q*", "destination": "/index.html" },
        { "source": "/watch/:p1*", "destination": "/index.html" },
        { "source": "/favorite", "destination": "/index.html" },
        { "source": "/home", "destination": "/index.html" }
    ]
}
